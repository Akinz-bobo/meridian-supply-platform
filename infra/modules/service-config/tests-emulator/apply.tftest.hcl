# Apply test. Creates real resources in the emulator, changes them, and
# destroys them when the file finishes. Needs the emulator running and
# AWS_ENDPOINT_URL set: run it with `make test-emulator`.
#
# It uses an account of its own, so it cannot touch an environment.

provider "aws" {
  region                      = "eu-west-1"
  access_key                  = "555555555555"
  secret_key                  = "emulator"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
}

variables {
  path          = "/meridian/test/apply-check"
  account_id    = "555555555555"
  kms_key_arn   = null
  kms_key_alias = "alias/meridian-test-secrets"
  tags = {
    Project = "meridian"
  }

  parameters = {
    log-level = "info"
  }

  secrets = {
    signing-key = {
      description = "Generated by the apply test."
      generate    = {}
    }
    partner-token = {
      description = "Left empty by the apply test."
    }
  }
}

run "creates_parameters_and_secrets" {
  command = apply

  assert {
    condition     = output.parameter_names["log-level"] == "/meridian/test/apply-check/config/log-level"
    error_message = "The parameter was not created at the expected name."
  }

  assert {
    condition     = length(output.secret_arns) == 2
    error_message = "Both secrets should exist."
  }

  assert {
    condition     = strcontains(output.secret_arns["signing-key"], ":secret:/meridian/test/apply-check/secrets/signing-key")
    error_message = "The secret's ARN should contain its path."
  }
}

run "a_second_apply_changes_nothing" {
  command = plan

  assert {
    condition     = aws_secretsmanager_secret_version.generated["signing-key"].secret_string_wo_version == 1
    error_message = "With the same version number the generated value must be left alone."
  }
}

run "raising_the_version_stores_a_new_value" {
  command = apply

  variables {
    secrets = {
      signing-key = {
        description = "Generated by the apply test."
        generate    = { version = 2 }
      }
      partner-token = {
        description = "Left empty by the apply test."
      }
    }
  }

  assert {
    condition     = aws_secretsmanager_secret_version.generated["signing-key"].secret_string_wo_version == 2
    error_message = "The new version number should be recorded."
  }
}

run "a_configuration_change_is_applied_in_place" {
  command = apply

  variables {
    parameters = {
      log-level = "debug"
    }
    secrets = {
      signing-key = {
        description = "Generated by the apply test."
        generate    = { version = 2 }
      }
      partner-token = {
        description = "Left empty by the apply test."
      }
    }
  }

  assert {
    condition     = aws_ssm_parameter.config["log-level"].value == "debug"
    error_message = "The parameter should hold the new value."
  }
}
