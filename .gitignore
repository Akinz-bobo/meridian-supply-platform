# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*.auto.tfvars
!example.auto.tfvars

# Lock files are committed for state layers, which are applied, and not for
# modules, whose callers decide the provider versions.
infra/modules/**/.terraform.lock.hcl

# Dependencies and build output
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local environment
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/

# Emulator state
.floci/
